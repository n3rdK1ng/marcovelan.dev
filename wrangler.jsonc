{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "marcovelan-dev",
	"compatibility_date": "2026-11-25",
	// Only proxies PostHog under /a/*; everything else is the Astro build output.
	"main": "./worker/index.js",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": ["/a/*"],
		// Serve dist/404.html with a 404 status for unknown paths.
		"not_found_handling": "404-page",
		// /cs serves /cs/index.html at /cs/.
		"html_handling": "auto-trailing-slash",
	},
	// The site lives on marcovelan.dev only, so search engines see one host.
	"workers_dev": false,
	// Keeps preview URLs for non-master builds now that workers_dev is off.
	"preview_urls": true,
	"previews": {},
}
