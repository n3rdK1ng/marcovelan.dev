---
import Layout from '../layouts/layout.astro'
---

<Layout title="Marco Velan: 404" description="Page not found">
	<div class="container">
		<div class="grid min-h-screen place-items-center">
			<div class="text-center">
				<p class="font-mono text-sm text-gold">404</p>
