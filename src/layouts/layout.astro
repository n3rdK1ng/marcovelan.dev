---
import { ClientRouter } from 'astro:transitions'
import { getLangFromUrl, useTranslations } from '../i18n/utils'
import PostHog from '../components/posthog.astro'
import '../styles/global.css'

interface Props {
	title: string
	description: string
	/** Keeps a page out of the index — no canonical, no hreflang, no og card. */
	noindex?: boolean
}

const { title, description, noindex = false } = Astro.props

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const site = Astro.site ?? new URL('https://marcovelan.dev')
const canonical = new URL(Astro.url.pathname, site).href
const enHref = new URL('/', site).href
const csHref = new URL('/cs/', site).href
// Cards are rendered from scripts/og.html, one per language.
const ogImage = new URL(lang === 'cs' ? '/og-cs.png' : '/og.png', site).href
const ogImageAlt = `Marco Velan · ${t('role')}`

/** Lets search engines read the page as one person's profile. */
const profile = {
	'@context': 'https://schema.org',
	'@type': 'ProfilePage',
	url: canonical,
	inLanguage: lang,
	mainEntity: {
		'@type': 'Person',
		name: 'Marco Velan',
		givenName: 'Marco',
		familyName: 'Velan',
		url: enHref,
		jobTitle: t('role'),
		description,
		address: { '@type': 'PostalAddress', addressCountry: 'CZ' },
		knowsLanguage: ['cs', 'en', 'hr', 'es'],
		knowsAbout: ['TypeScript', 'React', 'React Native', 'Node.js'],
		sameAs: [
			'https://www.linkedin.com/in/marcovelan/',
			'https://github.com/n3rdK1ng',
		],
	},
}
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Marco Velan" />
		{noindex ? (
			<meta name="robots" content="noindex" />
		) : (
			<>
				<link rel="canonical" href={canonical} />
				<link rel="alternate" hreflang="en" href={enHref} />
				<link rel="alternate" hreflang="cs" href={csHref} />
				<link rel="alternate" hreflang="x-default" href={enHref} />
				<meta property="og:type" content="profile" />
				<meta property="og:site_name" content="Marco Velan" />
				<meta property="og:title" content={title} />
				<meta property="og:description" content={description} />
				<meta property="og:url" content={canonical} />
				<meta
					property="og:locale"
					content={lang === 'cs' ? 'cs_CZ' : 'en_US'}
				/>
				<meta property="og:image" content={ogImage} />
				<meta property="og:image:width" content="1200" />
				<meta property="og:image:height" content="630" />
				<meta property="og:image:alt" content={ogImageAlt} />
				<meta
					property="og:locale:alternate"
					content={lang === 'cs' ? 'en_US' : 'cs_CZ'}
				/>
				<meta property="profile:first_name" content="Marco" />
				<meta property="profile:last_name" content="Velan" />
				<meta name="twitter:card" content="summary_large_image" />
				<meta name="twitter:image:alt" content={ogImageAlt} />
				<script
					type="application/ld+json"
					is:inline
					set:html={JSON.stringify(profile)}
				/>
			</>
		)}
		<meta
			name="theme-color"
			media="(prefers-color-scheme: light)"
			content="#ffffff"
		/>
		<meta
			name="theme-color"
			media="(prefers-color-scheme: dark)"
			content="#0a0a0a"
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="sitemap" type="application/xml" href="/sitemap.xml" />
		<meta name="generator" content={Astro.generator} />
		<ClientRouter />
		<PostHog />
		<!-- Cal element-click embed code begins -->
		<script is:inline type="text/javascript">
			;(function (C, A, L) {
				let p = function (a, ar) {
					a.q.push(ar)
				}
				let d = C.document
				C.Cal =
					C.Cal ||
					function () {
						let cal = C.Cal
						let ar = arguments
						if (!cal.loaded) {
							cal.ns = {}
							cal.q = cal.q || []
							d.head.appendChild(d.createElement('script')).src = A
							cal.loaded = true
						}
						if (ar[0] === L) {
							const api = function () {
								p(api, arguments)
							}
							const namespace = ar[1]
							api.q = api.q || []
							if (typeof namespace === 'string') {
								cal.ns[namespace] = cal.ns[namespace] || api
								p(cal.ns[namespace], ar)
								p(cal, ['initNamespace', namespace])
							} else p(cal, ar)
							return
						}
						p(cal, ar)
					}
			})(window, 'https://app.cal.com/embed/embed.js', 'init')
			Cal('init', { origin: 'https://cal.com' })
			// `auto` lets the embed read prefers-color-scheme itself, so the modal
			// follows the OS exactly like the page around it.
			Cal('ui', {
				theme: 'auto',
				cssVarsPerTheme: {
					light: { 'cal-brand': '#171717' },
					dark: { 'cal-brand': '#EDEDED' },
				},
				hideEventTypeDetails: true,
				layout: 'month_view',
			})
		</script>
		<!-- Cal element-click embed code ends -->
	</head>
	<body>
		<slot />
		<!--
			Signature interaction: hovering any technology highlights every other
			place with the same `data-tech` across the page. Delegated from `document`,
			so it survives ClientRouter view transitions without re-init, and the
			page is fully readable without it.
		-->
		<script is:inline>
			;(() => {
				if (window.__techLinkReady) return
				window.__techLinkReady = true
				const clear = () => {
					for (const el of document.querySelectorAll('[data-tech].is-linked')) {
						el.classList.remove('is-linked')
					}
				}
				document.addEventListener('pointerover', event => {
					// A tap fires pointerover too and would leave the highlight stuck.
					if (event.pointerType !== 'mouse') return
					const target = event.target
					const item =
						target instanceof Element ? target.closest('[data-tech]') : null
					clear()
					if (!item) return
					const tech = item.getAttribute('data-tech')
					for (const el of document.querySelectorAll(
						'[data-tech="' + tech + '"]',
					)) {
						el.classList.add('is-linked')
					}
				})
				document.documentElement.addEventListener('pointerleave', clear)
			})()
		</script>
		<!--
			`Book a call` is a real link so it still works without JS. Cal's embed
			opens its modal on any `[data-cal-link]` click but never cancels the
			default action, so the browser would follow the href on top of it —
			swallow the navigation once the embed is actually on the page.
		-->
		<script is:inline>
			;(() => {
				if (window.__calLinkReady) return
				window.__calLinkReady = true
				document.addEventListener('click', event => {
					if (event.defaultPrevented || event.button !== 0) return
					if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey)
						return
					const target = event.target
					const link =
						target instanceof Element
							? target.closest('a[data-cal-link]')
							: null
					if (!link) return
					// `Cal.loaded` is set by the loader snippet before embed.js lands;
					// `version` is only set once embed.js has actually run.
					if (!window.Cal || !window.Cal.version) return
					event.preventDefault()
				})
			})()
		</script>
		<!--
			The entrance is a first-load moment. ClientRouter swaps the document on
			every EN↔CS switch, which would replay the entrance on top of the
			cross-fade, so mark the root as loaded on swap and
			let the CSS opt out from there. Runs before the next paint, so the
			animations never get a chance to start.
		-->
		<script is:inline>
			;(() => {
				if (window.__loadedFlagReady) return
				window.__loadedFlagReady = true
				document.addEventListener('astro:after-swap', () => {
					document.documentElement.setAttribute('data-loaded', '')
				})
			})()
		</script>
	</body>
</html>
