---
interface Props {
	/** Steps separated by ` → ` in the translation string. */
	steps: string
	label: string
}

const { steps, label } = Astro.props

const list = steps.split(' → ')
---

<!--
	Geist Mono ships no arrow glyphs, so the arrows are drawn: one shape, one
	stroke, currentColor. The last step bends back to show the loop repeats.
-->
<ol class="loop" aria-label={label}>
	{
		list.map((step, index) => (
			<li class="loop-step">
				{step}
				{index < list.length - 1 ? (
					<svg
						width="10"
						height="10"
						viewBox="0 0 12 12"
						fill="none"
						stroke="currentColor"
						stroke-width="1.25"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path d="M2 6h8M7 3l3 3-3 3" />
					</svg>
				) : (
					<svg
						width="11"
						height="11"
						viewBox="0 0 12 12"
						fill="none"
						stroke="currentColor"
						stroke-width="1.25"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path d="M6 2a4 4 0 1 1-4 4M0.75 7.25 2 6l1.25 1.25" />
					</svg>
				)}
			</li>
		))
	}
</ol>
