---
interface Props {
	lang: string
	flag: string
	level: string
}

const { lang, flag, level } = Astro.props
---

<div
	class="rounded-lg border border-rule p-4 transition-all duration-300 hover:border-gold/20 hover:bg-elevated/50"
>
	<div class="text-2xl">{flag}</div>
	<p class="mt-2 text-sm font-medium text-cream">{lang}</p>
	<p class="mt-0.5 text-xs text-ash">{level}</p>
</div>
