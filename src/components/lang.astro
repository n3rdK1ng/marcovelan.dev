---
interface Props {
	lang: string
	flag: string
	level: string
	score: 1 | 2 | 3 | 4
}

const { lang, flag, level, score } = Astro.props
---

<div class="lang-row" data-level={score}>
	<div>
		<div class="lang-name">{lang}<span class="lang-flag">{flag}</span></div>
		<div class="lang-level">{level}</div>
	</div>
	<div class="lang-bar"><i></i><i></i><i></i><i></i></div>
</div>
