---
interface Props {
	name: string
	url?: string
	stack: string[]
}

const { name, url, stack } = Astro.props
---

<div class="project">
	<span class="project-name">
		{
			url ? (
				<a href={url} target="_blank" rel="noopener noreferrer">
					{name} ↗
				</a>
			) : (
				name
			)
		}
	</span>
	<div class="stack">
		{stack.map((s) => <span>{s}</span>)}
	</div>
</div>
