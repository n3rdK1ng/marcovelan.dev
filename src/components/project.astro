---
interface Props {
	name: string
	url?: string
	stack: string[]
}

const { name, url, stack } = Astro.props

/** 'TanStack Query' -> 'tanstack-query', 'shadcn/ui' -> 'shadcn-ui' */
const toTechId = (tech: string) =>
	tech
		.toLowerCase()
		.replace(/[^a-z0-9]+/g, '-')
		.replace(/^-+|-+$/g, '')
---

<li>
	<p class="project-name">
		{url ? (
			<a
				class="link print-url font-mono text-[0.8125rem]"
				href={url}
				target="_blank"
				rel="noopener noreferrer"
			>
				{name}
			</a>
		) : (
			<span class="text-ink font-mono text-[0.8125rem]">{name}</span>
		)}
	</p>
	{Astro.slots.has('default') && (
		<div class="mt-1.5 space-y-3 text-[0.9375rem]">
			<slot />
		</div>
	)}
	<p class="stack mt-1.5">
		{stack.map((tech, index) => (
			<Fragment>
				<span class="stack-item">
					<span data-tech={toTechId(tech)}>{tech}</span>
					{index < stack.length - 1 && (
						<span class="stack-sep" aria-hidden="true">
							{' ·'}
						</span>
					)}
				</span>
				{index < stack.length - 1 && ' '}
			</Fragment>
		))}
	</p>
</li>
