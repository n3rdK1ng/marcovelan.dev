---
interface Props {
	url?: string
	link?: string
	title?: string
}

const { url, link, title } = Astro.props
---

<div class="mt-3 rounded border border-rule/60 bg-elevated/50 p-3">
	{
		link && (
			<a
				href={url}
				target="_blank"
				rel="noopener noreferrer"
				class="text-sm font-medium text-gold link-gold"
			>
				{link}
				<span class="text-xs text-ash"> ↗</span>
			</a>
		)
	}
	{title && <p class="text-sm font-medium text-stone">{title}</p>}
	<p class="mt-1 font-mono text-xs leading-relaxed text-ash">
		<slot />
	</p>
</div>
