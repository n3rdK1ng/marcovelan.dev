---
interface Props {
	name: string
	url?: string
	stack: string[]
}

const { name, url, stack } = Astro.props

/** 'TanStack Query' -> 'tanstack-query', 'shadcn/ui' -> 'shadcn-ui' */
const toTechId = (tech: string) =>
	tech
		.toLowerCase()
		.replace(/[^a-z0-9]+/g, '-')
		.replace(/^-+|-+$/g, '')
---

<li>
	{
		url ? (
			<a
				class="link print-url font-mono text-[0.8125rem] font-medium"
				href={url}
				target="_blank"
				rel="noopener noreferrer"
			>
				{name}
			</a>
		) : (
			<span class="text-ink font-mono text-[0.8125rem] font-medium">
				{name}
			</span>
		)
	}
	<ul class="chips mt-2">
		{
			stack.map(tech => (
				<li class="chip" data-tech={toTechId(tech)}>
					{tech}
				</li>
			))
		}
	</ul>
</li>
