---
import Layout from '../layouts/layout.astro'
import Hero from './hero.astro'
import SectionBlock from './section-block.astro'
import Role from './role.astro'
import Project from './project.astro'
import Lang from './lang.astro'
import Achievement from './achievement.astro'
import { getLangFromUrl, useTranslations } from '../i18n/utils'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---

<Layout
	title={'Marco Velan — ' + t('resume')}
	description={'Marco Velan — Frontend Lead. ' + t('resume') + '.'}
>
	<main class="shell" id="top">
		<Hero />

		<SectionBlock id="experience" num="01" title={t('experience')}>
			<div class="roles">
				<Role
					position="Fullstack Lead"
					company="GoPortal"
					location={t('czechRepublic')}
					start={2025}
				>
					{t('goportalExperience')}
					<Fragment slot="projects">
						<Project
							name="app.goportal.cz"
							stack={[
								'React',
								'TypeScript',
								'TanStack Start',
								'Router',
								'Query',
								'Form',
								'Tailwind',
								'shadcn/ui',
								'Radix',
								'zod',
								'tRPC',
								'Effect',
								'Hono',
								'Better Auth',
								'Drizzle',
								'PostgreSQL',
								'Vitest',
								'Playwright',
								'Sentry',
								'Docker',
							]}
						/>
					</Fragment>
				</Role>

				<Role
					position="Frontend Lead"
					company="GoMobil"
					companyUrl="https://www.gomobil.cz/"
					location={t('czechRepublic')}
					start={2024}
					stack={[
						'React',
						'React Native',
						'Expo',
						'TypeScript',
						'Tailwind',
						'NativeWind',
						'rnr',
						'rn-primitives',
						'TanStack Start',
						'Router',
						'Query',
						'Form',
						'zod',
						'EAS',
						'Docker',
					]}
				>
					{t('gomobilExperience')}
				</Role>

				<Role
					position="IT Consultant"
					company="GoEnergy"
					companyUrl="https://www.goenergy.cz/"
					location={t('czechRepublic')}
					start={2024}
					stack={['React Native', 'Expo', 'TypeScript', 'gluestack-ui', 'EAS']}
				>
					{t('goenergyExperience')}
				</Role>

				<Role
					position="Frontend Developer"
					company="ScrumWorks"
					location={t('czechRepublic')}
					start={2024}
					end={2024}
				>
					{t('scrumWorksExperience')}
					<Fragment slot="projects">
						<Project
							name="amateurs.com"
							stack={[
								'React',
								'Next.js',
								'TypeScript',
								'Tailwind',
								'shadcn/ui',
								'Radix',
								'Ant Design',
								'zod',
								'Turborepo',
								'Vite',
								'tsup',
								'Storybook',
								'Web Components',
								'GraphQL Mesh',
							]}
						/>
					</Fragment>
				</Role>

				<Role
					position="Full-stack Developer"
					company="Blaze Company"
					companyUrl="https://blaze.codes/"
					location={t('czechRepublic')}
					start={2023}
					end={2024}
				>
					{t('blazeExperience')}
					<Fragment slot="projects">
						<Project
							name="xalarm.cz"
							url="https://www.xalarm.cz/"
							stack={[
								'React',
								'React Native',
								'TypeScript',
								'Expo',
								'Next.js',
								'tRPC',
								'Prisma',
								'Stripe',
								'RevenueCat',
								'Tailwind',
								'shadcn/ui',
								'Radix',
								'zod',
							]}
						/>
						<Project
							name="spudnow.co.uk"
							url="https://spudnow.co.uk/"
							stack={[
								'React Native',
								'TypeScript',
								'Expo',
								'Redux Toolkit',
								'NativeBase',
								'yup',
							]}
						/>
						<Project
							name="izzy.cz"
							url="https://izzy.cz/"
							stack={[
								'React',
								'Vue',
								'TypeScript',
								'Remix',
								'NestJS',
								'MongoDB',
								'TanStack Query',
								'Stripe',
								'Tailwind',
								'shadcn/ui',
								'Radix',
								'zod',
								'Vite',
							]}
						/>
						<Project
							name="Winning Tipsters"
							stack={[
								'React',
								'TypeScript',
								'Remix',
								'NestJS',
								'Prisma',
								'clerk',
								'Tailwind',
								'shadcn/ui',
								'Radix',
								'zod',
								'Vite',
							]}
						/>
					</Fragment>
				</Role>

				<Role
					position="Frontend Developer"
					company="Royal Fox"
					companyUrl="https://www.royal-fox.cz/"
					location={t('czechRepublic')}
					start={2023}
					end={2023}
				>
					{t('royalFoxExperience')}
					<Fragment slot="projects">
						<Project
							name="forclassmates.com"
							url="https://www.forclassmates.com/"
							stack={[
								'Vue',
								'Nuxt',
								'TypeScript',
								'Tiptap',
								'Pinia',
								'KaTeX',
								'MathLive',
								'Bootstrap',
								'Sass',
								'Element Plus',
								'Vite',
							]}
						/>
					</Fragment>
				</Role>

				<Role
					position="Freelance"
					company={t('selfEmployed')}
					location={t('czechRepublic')}
					start={2022}
				>
					{t('freelanceExperience')}
				</Role>
			</div>
		</SectionBlock>

		<SectionBlock id="languages" num="02" title={t('languages')}>
			<div class="langs">
				<Lang lang={t('czech')} flag="🇨🇿" level={t('native')} score={4} />
				<Lang lang={t('english')} flag="🇺🇸" level={t('comfort')} score={3} />
				<Lang lang={t('croatian')} flag="🇭🇷" level={t('commuticable')} score={2} />
				<Lang lang={t('spanish')} flag="🇪🇸" level={t('basic')} score={1} />
			</div>
		</SectionBlock>

		<SectionBlock id="hobbies" num="03" title={t('hobbies')}>
			<ul class="hobby-list">
				<li><span class="num">01</span><span class="text">{t('hobby1')}</span></li>
				<li><span class="num">02</span><span class="text">{t('hobby2')}</span></li>
				<li><span class="num">03</span><span class="text">{t('hobby3')}</span></li>
				<li><span class="num">04</span><span class="text">{t('hobby4')}</span></li>
			</ul>
		</SectionBlock>

		<SectionBlock id="achievements" num="04" title={t('achievemets')}>
			<ul class="ach-list">
				<Achievement year={2019}>{t('achievement1')}</Achievement>
				<Achievement year={2021}>{t('achievement2')}</Achievement>
				<Achievement year={2024}>{t('achievement3')}</Achievement>
			</ul>
		</SectionBlock>
	</main>
</Layout>
