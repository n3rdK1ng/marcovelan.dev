---
import Layout from '../layouts/layout.astro'
import Achievement from './achievement.astro'
import Experience from './experience.astro'
import Footer from './footer.astro'
import Header from './header.astro'
import Heading from './heading.astro'
import Hero from './hero.astro'
import Lang from './lang.astro'
import Project from './project.astro'
import { getLangFromUrl, useTranslations } from '../i18n/utils'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---

<Layout
	title={'Marco Velan: ' + t('resume')}
	description={t('metaDescription')}
>
	<div class="mx-auto w-full max-w-[44rem] px-6 lg:px-0">
		<Header />

		<main>
			<Hero />

			<section aria-labelledby="experience">
				<Heading id="experience">{t('experience')}</Heading>
				<ol class="timeline">
					<Experience
						position="Fullstack Lead"
						company="GoPortal"
						location={t('czechRepublic')}
						start={2025}
						description={t('goportalExperience')}
					>
						<Project
							name="app.goportal.cz"
							stack={[
								'React',
								'TS',
								'TanStack Start',
								'TanStack Router',
								'TanStack Query',
								'TanStack Form',
								'tailwindcss',
								'shadcn/ui',
								'Radix',
								'zod',
								'tRPC',
								'Effect',
								'Hono',
								'Better Auth',
								'Drizzle',
								'PostgreSQL',
								'Vitest',
								'Playwright',
								'Sentry',
								'Docker',
							]}
						/>
					</Experience>

					<Experience
						position="Frontend Lead"
						company="GoMobil"
						location={t('czechRepublic')}
						start={2024}
						description={t('gomobilExperience')}
					>
						<Project
							name="gomobil.cz"
							url="https://www.gomobil.cz/"
							stack={[
								'React',
								'React Native',
								'Expo',
								'TS',
								'tailwindcss',
								'NativeWind',
								'rnr',
								'rn-primitives',
								'TanStack Start',
								'TanStack Router',
								'TanStack Query',
								'TanStack Form',
								'zod',
								'EAS',
								'Docker',
							]}
						/>
					</Experience>

					<Experience
						position="IT Consultant"
						company="GoEnergy"
						location={t('czechRepublic')}
						start={2024}
						description={t('goenergyExperience')}
					>
						<Project
							name="goenergy.cz"
							url="https://www.goenergy.cz/"
							stack={['React Native', 'Expo', 'TS', 'gluestack-ui', 'EAS']}
						/>
					</Experience>

					<Experience
						position="Frontend Developer"
						company="ScrumWorks"
						location={t('czechRepublic')}
						start={2024}
						end={2024}
						description={t('scrumWorksExperience')}
					>
						<Project
							name="amateurs.com"
							stack={[
								'React',
								'Next.js',
								'TS',
								'tailwindcss',
								'shadcn/ui',
								'Radix',
								'Ant Design',
								'zod',
								'Turborepo',
								'Vite',
								'tsup',
								'Storybook',
								'Web Components',
								'GraphQL Mesh',
							]}
						/>
					</Experience>

					<Experience
						position="Full-stack Developer"
						company="Blaze Company"
						url="https://blaze.codes/"
						location={t('czechRepublic')}
						start={2023}
						end={2024}
						description={t('blazeExperience')}
					>
						<Project
							name="xalarm.cz"
							url="https://www.xalarm.cz/"
							stack={[
								'React',
								'React Native',
								'TS',
								'Expo',
								'Next.js',
								'tRPC',
								'Prisma',
								'Stripe',
								'RevenueCat',
								'tailwindcss',
								'shadcn/ui',
								'Radix',
								'zod',
							]}
						/>
						<Project
							name="spudnow.co.uk"
							url="https://spudnow.co.uk/"
							stack={[
								'React Native',
								'TS',
								'Expo',
								'Redux Toolkit',
								'NativeBase',
								'yup',
							]}
						/>
						<Project
							name="izzy.cz"
							url="https://izzy.cz/"
							stack={[
								'React',
								'Vue',
								'TS',
								'Remix',
								'NestJS',
								'MongoDB',
								'TanStack Query',
								'Stripe',
								'tailwindcss',
								'shadcn/ui',
								'Radix',
								'zod',
								'Vite',
							]}
						/>
						<Project
							name="Winning Tipsters"
							stack={[
								'React',
								'TS',
								'Remix',
								'NestJS',
								'Prisma',
								'clerk',
								'tailwindcss',
								'shadcn/ui',
								'Radix',
								'zod',
								'Vite',
							]}
						/>
					</Experience>

					<Experience
						position="Frontend Developer"
						company="Royal Fox"
						url="https://www.royal-fox.cz/"
						location={t('czechRepublic')}
						start={2023}
						end={2023}
						description={t('royalFoxExperience')}
					>
						<Project
							name="forclassmates.com"
							url="https://www.forclassmates.com/"
							stack={[
								'Vue',
								'Nuxt',
								'TS',
								'Tiptap',
								'Pinia',
								'KaTeX',
								'MathLive',
								'Bootstrap',
								'Sass',
								'Element Plus',
								'Vite',
							]}
						/>
					</Experience>

					<Experience
						position="Freelance"
						company={t('selfEmployed')}
						location={t('czechRepublic')}
						start={2022}
						description={t('freelanceExperience')}
					/>
				</ol>
			</section>

			<section class="mt-20" aria-labelledby="languages">
				<Heading id="languages">{t('languages')}</Heading>
				<ul>
					<Lang name={t('czech')} level={t('native')} score={5} />
					<Lang name={t('english')} level={t('englishLevel')} score={4} />
					<Lang name={t('croatian')} level={t('croatianLevel')} score={3} />
					<Lang name={t('spanish')} level={t('spanishLevel')} score={2} />
				</ul>
			</section>

			<section class="mt-20" aria-labelledby="hobbies">
				<Heading id="hobbies">{t('hobbies')}</Heading>
				<ul class="grid gap-x-10 sm:grid-cols-2">
					<li class="border-line border-t py-3">{t('hobby1')}</li>
					<li class="border-line border-t py-3">{t('hobby2')}</li>
					<li class="border-line border-t py-3">{t('hobby3')}</li>
					<li class="border-line border-t py-3">{t('hobby4')}</li>
				</ul>
			</section>

			<section class="mt-20" aria-labelledby="achievements">
				<Heading id="achievements">{t('achievements')}</Heading>
				<ul>
					<Achievement year={2019}>{t('achievement1')}</Achievement>
					<Achievement year={2021}>{t('achievement2')}</Achievement>
					<Achievement year={2024}>{t('achievement3')}</Achievement>
				</ul>
			</section>
		</main>

		<Footer />
	</div>
</Layout>
