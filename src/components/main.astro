---
import Achievement from './achievement.astro'
import Experience from './experience.astro'
import Header from './header.astro'
import Heading from './heading.astro'
import Lang from './lang.astro'
import Project from './project.astro'
import Separator from './separator.astro'
import Layout from '../layouts/layout.astro'
import { getLangFromUrl, useTranslations } from '../i18n/utils'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---

<Layout
	title={'Marco Velan: ' + t('resume')}
	description={'Marco Velan: ' + t('resume')}
>
	<Header />

	<section class="container pb-20 lg:pb-32">
		<div class="reveal mb-16 lg:mb-24">
			<div class="border-l border-gold/40 pl-5">
				<p class="text-base leading-relaxed text-stone lg:text-lg">
					{t('hero1')}
				</p>
				<p class="mt-4 text-base leading-relaxed text-stone lg:text-lg">
					{t('hero2')}
				</p>
			</div>
		</div>

		<Heading num="01">{t('contactInfo')}</Heading>
		<div class="reveal mt-6 grid gap-3 sm:grid-cols-3">
			<a
				href="mailto:marco.velan10@gmail.com"
				class="group flex items-center gap-3 rounded-lg border border-rule p-4 transition-all duration-300 hover:border-gold/30 hover:bg-elevated"
			>
				<span class="font-mono text-xs text-gold">@</span>
				<span
					class="text-sm text-stone transition-colors group-hover:text-cream"
					>marco.velan10@gmail.com</span
				>
			</a>
			<a
				href="https://www.linkedin.com/in/marcovelan/"
				target="_blank"
				rel="noopener noreferrer"
				class="group flex items-center gap-3 rounded-lg border border-rule p-4 transition-all duration-300 hover:border-gold/30 hover:bg-elevated"
			>
				<span class="font-mono text-xs text-gold">in</span>
				<span
					class="text-sm text-stone transition-colors group-hover:text-cream"
					>LinkedIn</span
				>
			</a>
			<button
				class="group flex items-center gap-3 rounded-lg border border-rule p-4 text-left transition-all duration-300 hover:border-gold/30 hover:bg-elevated"
				data-cal-link="marcovelan/job-offer"
				data-cal-namespace=""
				data-cal-config='{"layout":"month_view"}'
			>
				<span class="font-mono text-xs text-gold">cal</span>
				<span
					class="text-sm text-stone transition-colors group-hover:text-cream"
					>{t('openCalendar')}</span
				>
			</button>
		</div>

		<Separator />

		<Heading num="02">{t('experience')}</Heading>
		<div class="mt-8">
			<div class="relative border-l border-rule pl-6">
				<Experience
					position="Fullstack Lead"
					company="GoPortal"
					location={t('czechRepublic')}
					start={2025}
				>
					{t('goportalExperience')}
				</Experience>

				<Project title="app.goportal.cz">
					React, TS, TanStack Start, TanStack Router, TanStack Query, TanStack
					Form, tailwindcss, shadcn/ui, Radix, zod, tRPC, Effect, Hono, Better
					Auth, Drizzle, PostgreSQL, Vitest, Playwright, Sentry, Docker
				</Project>

				<Experience
					position="Frontend Lead"
					company="GoMobil"
					location={t('czechRepublic')}
					start={2024}
				>
					{t('gomobilExperience')}
				</Experience>

				<Project link="gomobil.cz" url="https://www.gomobil.cz/">
					React, React Native, Expo, TS, tailwindcss, NativeWind, rnr,
					rn-primitives, TanStack Start, TanStack Router, TanStack Query,
					TanStack Form, zod, EAS, Docker
				</Project>

				<Experience
					position="IT Consultant"
					company="GoEnergy"
					location={t('czechRepublic')}
					start={2024}
				>
					{t('goenergyExperience')}
				</Experience>

				<Project link="goenergy.cz" url="https://www.goenergy.cz/">
					React Native, Expo, TS, gluestack-ui, EAS
				</Project>

				<Experience
					position="Frontend Developer"
					company="ScrumWorks"
					location={t('czechRepublic')}
					start={2024}
					end={2024}
				>
					{t('scrumWorksExperience')}
				</Experience>

				<Project title="amateurs.com">
					React, Next.js, TS, tailwindcss, shadcn/ui, Radix, Ant Design, zod,
					Turborepo, Vite, tsup, Storybook, Web Components, GraphQL Mesh
				</Project>

				<Experience
					position="Full-stack Developer"
					url="https://blaze.codes/"
					link="blaze.codes"
					company="Blaze Company"
					location={t('czechRepublic')}
					start={2023}
					end={2024}
				>
					{t('blazeExperience')}
				</Experience>

				<Project url="https://www.xalarm.cz/" link="xalarm.cz">
					React, React Native, TS, Expo, Next.js, tRPC, Prisma, Stripe,
					RevenueCat, tailwindcss, shadcn/ui, Radix, zod
				</Project>
				<Project url="https://spudnow.co.uk/" link="spudnow.co.uk">
					React Native, TS, Expo, Redux Toolkit, NativeBase, yup
				</Project>
				<Project url="https://izzy.cz/" link="izzy.cz">
					React, Vue, TS, Remix, NestJS, MongoDB, TanStack Query, Stripe,
					tailwindcss, shadcn/ui, Radix, zod, Vite
				</Project>
				<Project title="Winning Tipsters">
					React, TS, Remix, NestJS, Prisma, clerk, tailwindcss, shadcn/ui,
					Radix, zod, Vite
				</Project>

				<Experience
					position="Frontend Developer"
					url="https://www.royal-fox.cz/"
					link="royal-fox.cz"
					company="Royal Fox"
					location={t('czechRepublic')}
					start={2023}
					end={2023}
				>
					{t('royalFoxExperience')}
				</Experience>

				<Project
					url="https://www.forclassmates.com/"
					link="forclassmates.com"
				>
					Vue, Nuxt, TS, Tiptap, Pinia, KaTeX, MathLive, Bootstrap, Sass,
					Element Plus, Vite
				</Project>

				<Experience
					position="Freelance"
					company={t('selfEmployed')}
					location={t('czechRepublic')}
					start={2022}
				>
					{t('freelanceExperience')}
				</Experience>
			</div>
		</div>

		<Separator />

		<Heading num="03">{t('languages')}</Heading>
		<div class="reveal mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
			<Lang lang={t('czech')} flag="🇨🇿" level={t('native')} />
			<Lang lang={t('english')} flag="🇺🇸" level={t('comfort')} />
			<Lang lang={t('croatian')} flag="🇭🇷" level={t('commuticable')} />
			<Lang lang={t('spanish')} flag="🇪🇸" level={t('basic')} />
		</div>

		<Separator />

		<Heading num="04">{t('hobbies')}</Heading>
		<ul class="reveal mt-6 grid gap-3 sm:grid-cols-2">
			<li class="flex items-center gap-3 text-sm text-stone">
				<span class="h-1 w-1 shrink-0 rounded-full bg-gold"></span>
				{t('hobby1')}
			</li>
			<li class="flex items-center gap-3 text-sm text-stone">
				<span class="h-1 w-1 shrink-0 rounded-full bg-gold"></span>
				{t('hobby2')}
			</li>
			<li class="flex items-center gap-3 text-sm text-stone">
				<span class="h-1 w-1 shrink-0 rounded-full bg-gold"></span>
				{t('hobby3')}
			</li>
			<li class="flex items-center gap-3 text-sm text-stone">
				<span class="h-1 w-1 shrink-0 rounded-full bg-gold"></span>
				{t('hobby4')}
			</li>
		</ul>

		<Separator />

		<Heading num="05">{t('achievemets')}</Heading>
		<div class="reveal mt-6 space-y-4">
			<Achievement year={2019}>
				{t('achievement1')}
			</Achievement>
			<Achievement year={2021}>
				{t('achievement2')}
			</Achievement>
			<Achievement year={2024}>
				{t('achievement3')}
			</Achievement>
		</div>
	</section>
</Layout>
