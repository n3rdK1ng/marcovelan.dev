---
import { getLangFromUrl, useTranslations } from '../i18n/utils'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---

<section class="pb-16 pt-10 sm:pb-20 sm:pt-16">
	<h1
		class="enter text-ink text-[2.5rem] font-medium leading-[1.1] tracking-[-0.05em]"
		style="--i: 0"
	>
		Marco Velan
	</h1>
	<p class="enter text-ink-muted mt-2" style="--i: 1">{t('role')}</p>
	<div class="enter mt-8 max-w-[36rem] space-y-3" style="--i: 2">
		<p>{t('hero1')}</p>
		<p class="text-ink-muted">{t('hero2')}</p>
	</div>
	<div class="enter mt-8 flex flex-wrap gap-2" style="--i: 3">
		{
			/*
			 * A real link, so it still books a call with JS off. The Cal embed
			 * intercepts the click on `data-cal-link` and opens its modal instead.
			 */
		}
		<a
			class="action action-primary"
			href="https://cal.com/marcovelan/30min"
			data-cal-link="marcovelan/30min"
			data-cal-namespace=""
			data-cal-config='{"layout":"month_view"}'
			data-print="cal.com/marcovelan/30min"
		>
			{t('bookCall')}
		</a>
		<a
			class="action"
			href="mailto:marco.velan10@gmail.com"
			data-print="marco.velan10@gmail.com"
		>
			Email
		</a>
		<a
			class="action"
			href="https://www.linkedin.com/in/marcovelan/"
			target="_blank"
			rel="noopener noreferrer"
			data-print="linkedin.com/in/marcovelan"
		>
			LinkedIn
		</a>
	</div>
</section>
