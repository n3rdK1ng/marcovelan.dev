---
import GitLink from './git-link.astro'
import LanguagePicker from './language-picker.astro'
---

<header class="container pt-10 pb-6 lg:pt-16 lg:pb-10 [view-transition-name:site-header]">
	<nav class="flex items-center justify-between mb-20 lg:mb-28">
		<LanguagePicker />
		<GitLink />
	</nav>
	<div class="reveal">
		<h1
			class="font-display text-6xl leading-[0.9] tracking-tight lg:text-8xl"
			style="font-style: italic;"
		>
			Marco
			<br />
			Velan
		</h1>
		<div class="mt-6 h-px w-12 bg-gold"></div>
	</div>
</header>
