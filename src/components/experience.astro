---
import Row from './row.astro'
import { getLangFromUrl, useTranslations } from '../i18n/utils'

interface Props {
	position: string
	company: string
	url?: string
	location: string
	start: number
	end?: number
	description: string
}

const { position, company, url, location, start, end, description } =
	Astro.props

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const range = start === end ? `${start}` : `${start} – ${end ?? t('present')}`
const hasProjects = Astro.slots.has('default')
---

<Row label={range}>
	<h3 class="text-ink font-medium leading-snug">
		{position}{' '}
		<span class="text-ink-muted font-normal">
			·{' '}
			{
				url ? (
					<a
						class="link print-url"
						href={url}
						target="_blank"
						rel="noopener noreferrer"
					>
						{company}
					</a>
				) : (
					company
				)
			}
		</span>
	</h3>
	<p class="meta mt-0.5">{location}</p>
	<p class="mt-3 text-[0.9375rem]">{description}</p>
	{
		hasProjects && (
			<ul class="mt-5 space-y-4">
				<slot />
			</ul>
		)
	}
</Row>
