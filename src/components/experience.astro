---
import { getLangFromUrl, useTranslations } from '../i18n/utils'

interface Props {
	position: string
	url?: string
	link?: string
	company: string
	location: string
	start: number
	end?: number
}

const { position, url, company, location, start, end } = Astro.props

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---

<div class="reveal relative py-6">
	<div
		class="absolute -left-7 top-8 h-2 w-2 rounded-full border-2 border-gold bg-surface"
	>
	</div>
	<h3 class="text-lg font-medium text-cream">{position}</h3>
	<div class="mt-1 flex flex-wrap items-center gap-x-2 text-sm">
		{
			url ? (
				<a
					href={url}
					target="_blank"
					rel="noopener noreferrer"
					class="font-medium text-gold link-gold"
				>
					{company}
				</a>
			) : (
				<span class="font-medium text-stone">{company}</span>
			)
		}
		<span class="text-ash">&middot;</span>
		<span class="text-ash">{location}</span>
		<span class="text-ash">&middot;</span>
		<span class="font-mono text-xs text-ash">
			{start === end ? start : `${start} – ${end ?? t('present')}`}
		</span>
	</div>
	<p class="mt-3 text-sm leading-relaxed text-stone">
		<slot />
	</p>
</div>
