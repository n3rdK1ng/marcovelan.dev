---
import { getLangFromUrl, useTranslations } from '../i18n/utils'

interface Props {
	position: string
	company: string
	url?: string
	location: string
	start: number
	end?: number
	description: string
}

const { position, company, url, location, start, end, description } =
	Astro.props

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const current = end === undefined
const range = start === end ? `${start}` : `${start} — ${end ?? t('present')}`
const hasProjects = Astro.slots.has('default')
---

<li class="entry pb-11 last:pb-0">
	<span class:list={['node', current && 'node-current']} aria-hidden="true"
	></span>
	<p class="meta">{range}</p>
	<h3
		class="font-display text-ink mt-1.5 text-[1.35rem] font-semibold leading-tight tracking-[-0.025em]"
	>
		{position}
	</h3>
	<p class="text-ink-muted mt-1 text-[0.9375rem]">
		{
			url ? (
				<a
					class="link print-url"
					href={url}
					target="_blank"
					rel="noopener noreferrer"
				>
					{company}
				</a>
			) : (
				<span class="text-ink font-medium">{company}</span>
			)
		}
		<span class="text-line mx-1.5" aria-hidden="true">/</span>{location}
	</p>
	<p class="mt-3">{description}</p>
	{
		hasProjects && (
			<ul class="border-line mt-5 space-y-4 border-l pl-5">
				<slot />
			</ul>
		)
	}
</li>
